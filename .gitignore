# Dependencies
node_modules/

# Build
dist/
desktop/dist/
release/

# Editor
*.local
.env*

# Local StarCraft data + map fixtures (not redistributable)
fixtures/

# Extracted Blizzard game data (regenerate with `npm run extract`)
/public/tileset/
/public/arr/
/public/game/
/public/scripts/
/public/unit/

# Plugin API declarations (regenerate with `npm run build:plugin-types`)
/plugin-api/

# Default plugins vendored into the desktop build (regenerate with `npm run vendor:plugins`)
/plugins/
