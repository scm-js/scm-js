{
  "name": "scm-js",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "desktop/dist/main.cjs",
  "repository": "github:scm-js/scm-js",
  "description": "A browser-based StarCraft: Brood War map editor — opens and writes .scm/.scx maps, with terrain, units, triggers and plugins.",
  "author": "scm-js",
  "license": "MIT",
  "homepage": "https://github.com/scm-js/scm-js#readme",
  "bugs": "https://github.com/scm-js/scm-js/issues",
  "scripts": {
    "predev": "node scripts/extract-assets.mjs --check --warn",
    "dev": "vite",
    "prebuild": "node scripts/extract-assets.mjs --check --warn",
    "build": "tsc -b && vite build",
    "build:desktop": "node scripts/build-desktop.mjs",
    "desktop": "vite build -c desktop/vite.config.ts && electron .",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "extract": "node scripts/extract-assets.mjs",
    "extract:tilesets": "node scripts/extract-tilesets.mjs",
    "extract:units": "node scripts/extract-units.mjs",
    "check:assets": "node scripts/extract-assets.mjs --check",
    "build:plugin-types": "node scripts/build-plugin-types.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "jotai": "^2.20.3",
    "lucide-react": "^1.38.0",
    "mopaq": "^1.3.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~6.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
